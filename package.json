{
  "name": "lunch-together-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/lunch-together-api/main",
    "prisma:migrate-dev": "npx prisma migrate dev --schema",
    "prisma:migrate-deploy": "npx prisma migrate deploy --schema",
    "prisma:generate-all": "npx prisma generate --schema prisma/group/schema.prisma & npx prisma generate --schema prisma/user/schema.prisma & npx prisma generate --schema prisma/meeting/schema.prisma",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/lunch-together-api/test/jest-e2e.json",
    "doc": "npx @compodoc/compodoc -p tsconfig.json -s --theme=laravel",
    "postinstall": "npm run prisma:generate-all"
  },
  "dependencies": {
    "@apollo/federation": "0.38.1",
    "@apollo/gateway": "^2.5.1",
    "@apollo/server": "^4.9.0",
    "@apollo/subgraph": "2.2.3",
    "@nestjs/apollo": "^12.0.7",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.0.3",
    "@nestjs/graphql": "^12.0.8",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/microservices": "^10.2.1",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.1.3",
    "@nestjs/websockets": "^10.1.3",
    "@paralleldrive/cuid2": "^2.2.1",
    "@prisma/client": "^4.14.1",
    "@socket.io/admin-ui": "^0.5.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "cache-manager": "^5.2.3",
    "cache-manager-redis-store": "^3.0.1",
    "graphql": "^16.7.0",
    "ioredis": "^5.3.2",
    "joi": "^17.9.2",
    "lodash": "^4.17.21",
    "oxide.ts": "^1.1.0",
    "redis": "^3.1.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@compodoc/compodoc": "^1.1.21",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cache-manager": "^4.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/lodash": "^4.14.196",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "prisma": "^4.14.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@lib/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@lib/user/application(|/.*)$": "<rootDir>/libs/user/application/src/$1",
      "^@lib/user/domain(|/.*)$": "<rootDir>/libs/user/domain/src/$1",
      "^@lib/user/infrastructure(|/.*)$": "<rootDir>/libs/user/infrastructure/src/$1",
      "^@lib/user/graphql-ui(|/.*)$": "<rootDir>/libs/user/graphql-ui/src/$1",
      "^@lib/group/domain(|/.*)$": "<rootDir>/libs/group/domain/src/$1",
      "^@lib/group/infrastructure(|/.*)$": "<rootDir>/libs/group/infrastructure/src/$1",
      "^@lib/group/graphql-ui(|/.*)$": "<rootDir>/libs/group/graphql-ui/src/$1",
      "^@lib/group/application(|/.*)$": "<rootDir>/libs/group/application/src/$1",
      "^@lib/user/rest-ui(|/.*)$": "<rootDir>/libs/user/rest-ui/src/$1",
      "^@lib/meeting/domain(|/.*)$": "<rootDir>/libs/meeting/domain/src/$1",
      "^@lib/meeting/socket(|/.*)$": "<rootDir>/libs/meeting/socket/src/$1",
      "^@lib/meeting/infrastructure(|/.*)$": "<rootDir>/libs/meeting/infrastructure/src/$1",
      "^@lib/meeting/application(|/.*)$": "<rootDir>/libs/meeting/application/src/$1",
      "^@lib/meeting/graphql-ui(|/.*)$": "<rootDir>/libs/meeting/graphql-ui/src/$1",
      "^@lib/group/tcp-ui(|/.*)$": "<rootDir>/libs/group/tcp-ui/src/$1",
      "^@lib/user/tcp-ui(|/.*)$": "<rootDir>/libs/user/tcp-ui/src/$1",
      "^@lib/meeting/rmq-ui(|/.*)$": "<rootDir>/libs/meeting/rmq-ui/src/$1",
      "^@lib/meeting/tcp-ui(|/.*)$": "<rootDir>/libs/meeting/tcp-ui/src/$1"
    }
  }
}
