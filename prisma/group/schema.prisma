// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/group-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DB")
}

model Group {
  id        String   @id @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  version   Int      @default(0)

  name         String
  groupMembers Member[]
  roles        Role[]

  @@map("group")
}

model Role {
  id        String   @id @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  version   Int      @default(0)

  name    String // Group owner, admin, member
  groupId String

  group       Group        @relation(fields: [groupId], references: [id])
  memberRoles MemberRole[]

  @@index([groupId])
  @@map("role")
}

model Member {
  id        String   @id @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  version   Int      @default(0)

  name    String
  avatar  String?
  userId  String
  groupId String

  group       Group        @relation(fields: [groupId], references: [id])
  memberRoles MemberRole[]

  @@index([groupId])
  @@map("member")
}

model MemberRole {
  id        String   @id @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  version   Int      @default(0)

  groupMemberId String
  roleId        String

  groupMember Member @relation(fields: [groupMemberId], references: [id])
  groupRole   Role   @relation(fields: [roleId], references: [id])

  @@index([groupMemberId, roleId])
  @@map("member_role")
}
